{
  "grid": "2 px sub-grid; most values are multiples of 4",
  "window": {
    "cornerRadius": 12,
    "titlebarHeight": 38,
    "titlebarPaddingX": 14
  },
  "transcript": {
    "padding": [
      20,
      28,
      6,
      28
    ],
    "blockGap": 16,
    "anchor": "bottom"
  },
  "rail": {
    "width": 180,
    "padding": [
      18,
      16
    ],
    "gap": 18
  },
  "bottom": {
    "padding": [
      0,
      24,
      12,
      24
    ],
    "statusBarHeight": 22,
    "statusGap": 10,
    "separator": " · "
  },
  "input": {
    "marginTop": 8,
    "padding": [
      11,
      14
    ],
    "radius": 8,
    "border": "1px accent",
    "gap": 10
  },
  "permission": {
    "padding": [
      14,
      16,
      12,
      16
    ],
    "radius": 8,
    "gap": 10,
    "border": "1px accent"
  },
  "radius": {
    "base": 6,
    "controls": 4,
    "inputs": 8,
    "window": 12
