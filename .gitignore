target/
target-dev/
.build/
.swiftpm/
xcuserdata/
DerivedData/
*.profraw
# scripts/package.sh output (Elisa.app, the .dmg)
dist/

# live run logs (protocol logs hold chat content) and self-test output
run-logs/
selftest-note.txt
*.log

# per-project Elisa state (sessions, index, memory)
.elisa/

# local secrets: model connections live in ~/.config/elisa/providers.toml, never in the repo
providers.toml
.env
.env.*

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
__pycache__/
*.pyc

# patch leftovers and local agent tooling (personal settings, temporary worktrees)
*.orig
*.rej
.claude/

# the paid intent router (model weights + spec): served from our server, never in the repo or the app
decision_models/
# model weights anywhere else (router tests, local models)
*.gguf
*.safetensors

# local self-test inputs (a PDF the self-test reads; not redistributed)
.selftest/
