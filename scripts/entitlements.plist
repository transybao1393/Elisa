<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements of Elisa.app (scripts/package.sh). Not sandboxed (App Sandbox off): the window starts the core, which
     reads the project folder and runs approved commands. Under the hardened runtime the microphone needs
     audio-input (voice input, Voice.swift); nothing else is relaxed. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
